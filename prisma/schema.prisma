generator client {
  provider      = "prisma-client-js"
  output        = "../lib/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  password              String?
  role                  Role                   @default(USER)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  notes                 Note[]
  serviceRequests ServiceRequest[]
  businessRegistrations BusinessRegistration[]
  househoodAccount      HousehoodAccount?
}

enum Role {
  USER
  ADMIN
}

enum HousehoodRole {
  resident
  manager
  operations
}

enum BusinessRole {
  OWNER
  ADMINISTRATOR
  MANAGER
  ACCOUNTANT
  SALES_STAFF
  INVENTORY_STAFF
  HR_PAYROLL
  EMPLOYEE
}

enum StockMovementType {
  OPENING
  ADJUSTMENT
  PURCHASE
  SALE
  RETURN
  TRANSFER_IN
  TRANSFER_OUT
  DAMAGE
}

model Business {
  id          String               @id @default(cuid())
  name        String
  businessType String?
  currency    String               @default("NGN")
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  memberships BusinessMembership[]
  auditLogs   AuditLog[]
  categories  ProductCategory[]
  products    Product[]
  warehouses  Warehouse[]
  stockMovements StockMovement[]
}

model BusinessMembership {
  id         String       @id @default(cuid())
  businessId String
  authUserId String
  role       BusinessRole @default(OWNER)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, authUserId])
  @@index([authUserId, businessId])
}

model AuditLog {
  id             String   @id @default(cuid())
  businessId     String
  actorAuthUserId String
  action         String
  entity         String
  entityId       String
  metadata       Json?
  createdAt      DateTime @default(now())
  business       Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([businessId, createdAt])
  @@index([actorAuthUserId, createdAt])
}

model ProductCategory {
  id         String    @id @default(cuid())
  businessId String
  name       String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products   Product[] @relation("BusinessProductCategory")

  @@unique([businessId, name])
  @@unique([businessId, id])
  @@index([businessId])
}

model Product {
  id              String           @id @default(cuid())
  businessId      String
  categoryId      String?
  name            String
  sku             String?
  unit            String           @default("each")
  costPrice       Decimal          @default(0) @db.Decimal(12, 2)
  sellingPrice    Decimal          @default(0) @db.Decimal(12, 2)
  trackInventory  Boolean          @default(true)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category        ProductCategory? @relation("BusinessProductCategory", fields: [businessId, categoryId], references: [businessId, id], onDelete: Restrict)
  stockMovements  StockMovement[]

  @@unique([businessId, sku])
  @@unique([businessId, id])
  @@index([businessId, name])
  @@index([categoryId])
}

model Warehouse {
  id             String          @id @default(cuid())
  businessId     String
  name           String
  address        String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]

  @@unique([businessId, name])
  @@unique([businessId, id])
  @@index([businessId])
}

model StockMovement {
  id             String            @id @default(cuid())
  businessId     String
  productId      String
  warehouseId    String
  type           StockMovementType
  quantity       Decimal           @db.Decimal(12, 3)
  unitCost       Decimal?          @db.Decimal(12, 2)
  reason         String?
  idempotencyKey String?
  actorAuthUserId String
  createdAt      DateTime          @default(now())
  business       Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  product        Product           @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Restrict)
  warehouse      Warehouse         @relation(fields: [businessId, warehouseId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, idempotencyKey])
  @@index([businessId, productId, warehouseId, createdAt])
  @@index([businessId, createdAt])
}

model Note {
  id        String   @id @default(uuid())
  text      String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
}

model HousehoodAccount {
  userId    String        @id
  role      HousehoodRole
  createdAt DateTime      @default(now())
  updatedAt DateTime      @default(now()) @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([role])
}

model Service {
  id          String     @id @default(uuid())
  name        String     @unique
  description String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  serviceRequests ServiceRequest[]
}

model ServiceRequest {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  serviceId   String
  service     Service    @relation(fields: [serviceId], references: [id])
  details     String
  status      String     @default("PENDING")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model TrainingCourse {
  id          String     @id @default(uuid())
  name        String
  description String
  duration    String
  price       Float
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model BusinessRegistration {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  businessName String
  businessType String
  status      String     @default("PENDING")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model CafeMenuItem {
  id          String     @id @default(uuid())
  name        String
  description String
  price       Float
  category    String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model NewsletterSubscription {
  id        String   @id @default(uuid())
  email     String   @unique
  subscribedAt DateTime @default(now())
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

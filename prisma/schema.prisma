generator client {
  provider      = "prisma-client-js"
  output        = "../lib/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  password              String?
  role                  Role                   @default(USER)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  notes                 Note[]
  serviceRequests       ServiceRequest[]
  businessRegistrations BusinessRegistration[]
  househoodAccount      HousehoodAccount?
}

enum Role {
  USER
  ADMIN
}

enum HousehoodRole {
  resident
  manager
  operations
}

enum BusinessRole {
  OWNER
  ADMINISTRATOR
  MANAGER
  ACCOUNTANT
  SALES_STAFF
  INVENTORY_STAFF
  HR_PAYROLL
  EMPLOYEE
}

enum StockMovementType {
  OPENING
  ADJUSTMENT
  PURCHASE
  SALE
  RETURN
  TRANSFER_IN
  TRANSFER_OUT
  DAMAGE
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  POS
  OTHER
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum PurchaseStatus {
  DRAFT
  COMPLETED
  VOIDED
}

enum ExpenseStatus {
  DRAFT
  APPROVED
  PAID
  VOIDED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum DocumentStatus {
  UPLOADED
  ARCHIVED
}

enum NotificationStatus {
  PENDING
  READ
  ARCHIVED
}

enum PermissionScope {
  BUSINESS
  MODULE
  RECORD
}

model Business {
  id                String               @id @default(cuid())
  name              String
  businessType      String?
  currency          String               @default("NGN")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  memberships       BusinessMembership[]
  auditLogs         AuditLog[]
  events            BusinessEvent[]
  categories        ProductCategory[]
  products          Product[]
  warehouses        Warehouse[]
  stockMovements    StockMovement[]
  customers         Customer[]
  sales             Sale[]
  payments          Payment[]
  accounts          Account[]
  journalEntries    JournalEntry[]
  journalLines      JournalLine[]
  suppliers         Supplier[]
  purchases         Purchase[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  permissions       BusinessPermission[]
  approvalRequests  ApprovalRequest[]
  documents         Document[]
  notifications     Notification[]
}

model BusinessMembership {
  id         String       @id @default(cuid())
  businessId String
  authUserId String
  role       BusinessRole @default(OWNER)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, authUserId])
  @@index([authUserId, businessId])
}

model AuditLog {
  id              String   @id @default(cuid())
  businessId      String
  actorAuthUserId String
  action          String
  entity          String
  entityId        String
  metadata        Json?
  createdAt       DateTime @default(now())
  business        Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([businessId, createdAt])
  @@index([actorAuthUserId, createdAt])
}

// Business events record operational activity for reporting and auditability.
// They deliberately remain separate from the future double-entry journal.
model BusinessEvent {
  id              String   @id @default(cuid())
  businessId      String
  eventType       String
  entityType      String
  entityId        String
  actorAuthUserId String
  data            Json?
  occurredAt      DateTime @default(now())
  business        Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([businessId, occurredAt])
  @@index([businessId, entityType, entityId])
}

model ProductCategory {
  id         String    @id @default(cuid())
  businessId String
  name       String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products   Product[] @relation("BusinessProductCategory")

  @@unique([businessId, name])
  @@unique([businessId, id])
  @@index([businessId])
}

model Product {
  id             String           @id @default(cuid())
  businessId     String
  categoryId     String?
  name           String
  sku            String?
  unit           String           @default("each")
  costPrice      Decimal          @default(0) @db.Decimal(12, 2)
  sellingPrice   Decimal          @default(0) @db.Decimal(12, 2)
  trackInventory Boolean          @default(true)
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  business       Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category       ProductCategory? @relation("BusinessProductCategory", fields: [businessId, categoryId], references: [businessId, id], onDelete: Restrict)
  stockMovements StockMovement[]
  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]

  @@unique([businessId, sku])
  @@unique([businessId, id])
  @@index([businessId, name])
  @@index([categoryId])
}

model Warehouse {
  id             String          @id @default(cuid())
  businessId     String
  name           String
  address        String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]
  sales          Sale[]
  purchases      Purchase[]

  @@unique([businessId, name])
  @@unique([businessId, id])
  @@index([businessId])
}

model StockMovement {
  id              String            @id @default(cuid())
  businessId      String
  productId       String
  warehouseId     String
  type            StockMovementType
  quantity        Decimal           @db.Decimal(12, 3)
  unitCost        Decimal?          @db.Decimal(12, 2)
  reason          String?
  idempotencyKey  String?
  actorAuthUserId String
  createdAt       DateTime          @default(now())
  business        Business          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  product         Product           @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Restrict)
  warehouse       Warehouse         @relation(fields: [businessId, warehouseId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, idempotencyKey])
  @@index([businessId, productId, warehouseId, createdAt])
  @@index([businessId, createdAt])
}

model Customer {
  id         String   @id @default(cuid())
  businessId String
  name       String
  email      String?
  phone      String?
  address    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sales      Sale[]

  @@unique([businessId, id])
  @@index([businessId, name])
  @@index([businessId, email])
}

model Sale {
  id                 String        @id @default(cuid())
  businessId         String
  customerId         String?
  warehouseId        String
  reference          String
  status             SaleStatus    @default(COMPLETED)
  paymentStatus      PaymentStatus @default(UNPAID)
  subtotal           Decimal       @db.Decimal(12, 2)
  discountAmount     Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount          Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal       @db.Decimal(12, 2)
  idempotencyKey     String
  requestFingerprint String
  actorAuthUserId    String
  occurredAt         DateTime      @default(now())
  voidedAt           DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  business           Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer           Customer?     @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: Restrict)
  warehouse          Warehouse     @relation(fields: [businessId, warehouseId], references: [businessId, id], onDelete: Restrict)
  items              SaleItem[]
  payments           Payment[]

  @@unique([businessId, id])
  @@unique([businessId, reference])
  @@unique([businessId, idempotencyKey])
  @@index([businessId, occurredAt])
  @@index([businessId, customerId, occurredAt])
}

model SaleItem {
  id          String   @id @default(cuid())
  businessId  String
  saleId      String
  productId   String
  description String
  quantity    Decimal  @db.Decimal(12, 3)
  unitPrice   Decimal  @db.Decimal(12, 2)
  unitCost    Decimal  @db.Decimal(12, 2)
  lineTotal   Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  sale        Sale     @relation(fields: [businessId, saleId], references: [businessId, id], onDelete: Restrict)
  product     Product  @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, saleId])
  @@index([businessId, productId])
}

model Payment {
  id                 String        @id @default(cuid())
  businessId         String
  saleId             String
  amount             Decimal       @db.Decimal(12, 2)
  method             PaymentMethod
  idempotencyKey     String
  requestFingerprint String
  receivedAt         DateTime      @default(now())
  actorAuthUserId    String
  createdAt          DateTime      @default(now())
  sale               Sale          @relation(fields: [businessId, saleId], references: [businessId, id], onDelete: Restrict)
  business           Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@unique([businessId, idempotencyKey])
  @@unique([businessId, id])
  @@index([businessId, saleId, receivedAt])
}

model Account {
  id           String        @id @default(cuid())
  businessId   String
  code         String
  name         String
  type         AccountType
  isSystem     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  journalLines JournalLine[]

  @@unique([businessId, id])
  @@unique([businessId, code])
  @@index([businessId, type])
}

model JournalEntry {
  id              String        @id @default(cuid())
  businessId      String
  sourceType      String
  sourceId        String
  memo            String?
  actorAuthUserId String
  occurredAt      DateTime      @default(now())
  createdAt       DateTime      @default(now())
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  lines           JournalLine[]

  @@unique([businessId, id])
  @@unique([businessId, sourceType, sourceId])
  @@index([businessId, occurredAt])
}

model JournalLine {
  id             String       @id @default(cuid())
  businessId     String
  journalEntryId String
  accountId      String
  debit          Decimal      @default(0) @db.Decimal(12, 2)
  credit         Decimal      @default(0) @db.Decimal(12, 2)
  createdAt      DateTime     @default(now())
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  journalEntry   JournalEntry @relation(fields: [businessId, journalEntryId], references: [businessId, id], onDelete: Restrict)
  account        Account      @relation(fields: [businessId, accountId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, accountId, createdAt])
  @@index([businessId, journalEntryId])
}

model Supplier {
  id         String     @id @default(cuid())
  businessId String
  name       String
  email      String?
  phone      String?
  address    String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchases  Purchase[]

  @@unique([businessId, id])
  @@unique([businessId, name])
  @@index([businessId, name])
}

model Purchase {
  id                 String         @id @default(cuid())
  businessId         String
  supplierId         String
  warehouseId        String
  reference          String
  status             PurchaseStatus @default(DRAFT)
  subtotal           Decimal        @db.Decimal(12, 2)
  taxAmount          Decimal        @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal        @db.Decimal(12, 2)
  idempotencyKey     String
  requestFingerprint String
  actorAuthUserId    String
  occurredAt         DateTime       @default(now())
  voidedAt           DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  business           Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  supplier           Supplier       @relation(fields: [businessId, supplierId], references: [businessId, id], onDelete: Restrict)
  warehouse          Warehouse      @relation(fields: [businessId, warehouseId], references: [businessId, id], onDelete: Restrict)
  items              PurchaseItem[]

  @@unique([businessId, id])
  @@unique([businessId, reference])
  @@unique([businessId, idempotencyKey])
  @@index([businessId, occurredAt])
  @@index([businessId, supplierId, occurredAt])
}

model PurchaseItem {
  id          String   @id @default(cuid())
  businessId  String
  purchaseId  String
  productId   String
  description String
  quantity    Decimal  @db.Decimal(12, 3)
  unitCost    Decimal  @db.Decimal(12, 2)
  lineTotal   Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  purchase    Purchase @relation(fields: [businessId, purchaseId], references: [businessId, id], onDelete: Restrict)
  product     Product  @relation(fields: [businessId, productId], references: [businessId, id], onDelete: Restrict)

  @@index([businessId, purchaseId])
  @@index([businessId, productId])
}

model ExpenseCategory {
  id         String    @id @default(cuid())
  businessId String
  name       String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  expenses   Expense[]

  @@unique([businessId, id])
  @@unique([businessId, name])
  @@index([businessId])
}

model Expense {
  id                   String          @id @default(cuid())
  businessId           String
  categoryId           String
  amount               Decimal         @db.Decimal(12, 2)
  status               ExpenseStatus   @default(DRAFT)
  paymentMethod        PaymentMethod   @default(CASH)
  description          String
  occurredAt           DateTime        @default(now())
  idempotencyKey       String
  actorAuthUserId      String
  approvedByAuthUserId String?
  paidAt               DateTime?
  voidedAt             DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  business             Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  category             ExpenseCategory @relation(fields: [businessId, categoryId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, id])
  @@unique([businessId, idempotencyKey])
  @@index([businessId, occurredAt])
  @@index([businessId, categoryId, occurredAt])
}

model BusinessPermission {
  id         String          @id @default(cuid())
  businessId String
  role       BusinessRole
  capability String
  scope      PermissionScope @default(MODULE)
  createdAt  DateTime        @default(now())
  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, role, capability, scope])
  @@index([businessId, role])
}

model ApprovalRequest {
  id                    String         @id @default(cuid())
  businessId            String
  module                String
  entityType            String
  entityId              String
  status                ApprovalStatus @default(PENDING)
  requestedByAuthUserId String
  resolvedByAuthUserId  String?
  resolvedAt            DateTime?
  reason                String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  business              Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@unique([businessId, id])
  @@index([businessId, status, createdAt])
  @@index([businessId, entityType, entityId])
}

model Document {
  id              String         @id @default(cuid())
  businessId      String
  module          String
  entityType      String
  entityId        String
  status          DocumentStatus @default(UPLOADED)
  name            String
  contentType     String
  size            Int
  storageKey      String         @unique
  actorAuthUserId String
  createdAt       DateTime       @default(now())
  archivedAt      DateTime?
  business        Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@unique([businessId, id])
  @@index([businessId, module, entityType, entityId])
  @@index([businessId, createdAt])
}

model Notification {
  id         String             @id @default(cuid())
  businessId String
  authUserId String
  status     NotificationStatus @default(PENDING)
  type       String
  title      String
  message    String
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime           @default(now())
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, id])
  @@index([businessId, authUserId, status, createdAt])
}

model Note {
  id        String   @id @default(uuid())
  text      String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
}

model HousehoodAccount {
  userId    String        @id
  role      HousehoodRole
  createdAt DateTime      @default(now())
  updatedAt DateTime      @default(now()) @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([role])
}

model Service {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  serviceRequests ServiceRequest[]
}

model ServiceRequest {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id])
  details   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrainingCourse {
  id          String   @id @default(uuid())
  name        String
  description String
  duration    String
  price       Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BusinessRegistration {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  businessName String
  businessType String
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CafeMenuItem {
  id          String   @id @default(uuid())
  name        String
  description String
  price       Float
  category    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NewsletterSubscription {
  id           String   @id @default(uuid())
  email        String   @unique
  subscribedAt DateTime @default(now())
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
